# GreenNode MaaS (OpenAI-compatible)
GREENNODE_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=
# Demo không cần LLM/DNS: đặt true để backend tự trả lời + extract lead bằng regex
LLM_MOCK=false

# Zalo Official Account
ZALO_BOT_TOKEN=
ZALO_OA_SECRET_KEY=

# Dashboard API protection (GET /api/leads)
DASHBOARD_API_KEY=

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supsale
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/supsale

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8501
