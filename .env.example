# GreenNode MaaS (OpenAI-compatible)
GREENNODE_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL_CUSTOMER=qwen/qwen3.6-flash
LLM_MODEL_STAFF=qwen/qwen3.6-flash

# Zalo Official Account
ZALO_BOT_TOKEN=
ZALO_OA_SECRET_KEY=

# Dashboard API protection
DASHBOARD_API_KEY=demo-key

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supsale
DATABASE_URL=jdbc:postgresql://db:5432/supsale

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=3600000

# Email (leave empty = mock mode, no real email sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@sup-sale.msb.demo
